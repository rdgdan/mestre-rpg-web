rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções de Ajuda
    function isMaster() {
      return request.auth != null && 
        (request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2' || 
         request.auth.uid == 'WR0168EySccvAQXnvPoozEEpb1u2');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. Coleções de Referência (Biblioteca Global)
    // Usamos curingas recursivos {doc=**} para garantir que o App Android
    // consiga acessar caminhos profundos como game_rules/feats/list
    match /magias/{doc=**}   { allow read: if true; allow write: if isMaster(); }
    match /armas/{doc=**}    { allow read: if true; allow write: if isMaster(); }
    match /itens/{doc=**}    { allow read: if true; allow write: if isMaster(); }
    match /monsters/{doc=**} { allow read: if true; allow write: if isMaster(); }
    match /classes/{doc=**}  { allow read: if true; allow write: if isMaster(); }
    match /races/{doc=**}    { allow read: if true; allow write: if isMaster(); }
    match /npcs/{doc=**}     { allow read: if true; allow write: if isMaster(); }
    match /game_rules/{doc=**} {
      allow read: if true;
      allow write: if isMaster();
    }

    // 2. Campanhas, Confrontos e Batalhas
    // Liberado para qualquer usuário logado criar e participar
    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null; 
    }
    match /encounters/{encounterId} {
      allow read, write: if request.auth != null;
    }
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
    match /arenas_online/{arenaId} {
      allow read, write: if request.auth != null;
    }

    // 3. Coleções Privadas / Customizadas de Jogadores
    match /custom_spells/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /custom_monsters/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /library_metadata/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 4. Personagens (Fichas)
    // IMPORTANTE: Permitimos leitura por qualquer usuário logado para que o Mestre (Host) 
    // consiga visualizar a ficha do jogador durante uma batalha.
    match /personagens/{charId=**} {
      allow read, write: if request.auth != null;
    }

    // Regra Padrão: Bloqueia tudo o que não foi definido acima
    match /{path=**} {
      allow read, write: if isMaster(); // Mestres têm acesso total de fallback
    }
  }
}

