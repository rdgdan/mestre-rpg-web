rules_version = '2'; service cloud.firestore { match /databases/{database}/documents {

// 1. Coleções de Referência (Banco de Dados Central)
// Permite que qualquer um leia (Android), mas apenas VOCÊ (Web) escreva.
match /magias/{doc}   { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /armas/{doc}    { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /itens/{doc}    { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /monsters/{doc} { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /classes/{doc}  { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /npcs/{doc}     { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /escudos/{doc}  { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /game_rules/{doc}  { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
match /races/{doc}    { allow read: if true; allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2'; }
// 2. Campanhas (Criadas na Web)
match /campaigns/{campaignId} {
  allow read: if true;
  allow write: if request.auth != null; 
}

match /game_rules/race_features/races/{doc} {
  allow read: if true;
  allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2';
}

match /game_rules/feats/{doc} {
  allow read: if true;
  allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2';
}
match /game_rules/class_features/{doc} {
  allow read: if true;
  allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2';
}
match /game_rules/race_features/{doc} {
  allow read: if true;
  allow write: if request.auth.uid == 'cynl59ZjdlgUJbuzs8lkufCWI0W2';
}
// 3. Personagens (Se você decidir sincronizar no futuro)
match /personagens/{charId} {
  allow read, write: if request.auth != null;
}
// Regra Padrão: Bloqueia tudo o que não foi definido acima
match /{path=**} {
  allow read, write: if false;
}
} }

